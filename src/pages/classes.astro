---
import Layout from "../layouts/Layout.astro";
import { ClassGrid } from "../components/classes/ClassGrid.astro";
---

<Layout>
		<section class="flex flex-col">
			<div
				class="relative z-10 flex flex-col max-w-[700px] w-full px-6 py-15 lg:px-0 lg:py-0 max-md:mx-auto max-md:w-fit">
				<h1
					class="font-bold text-white uppercase text-[96px] max-lg:text-[48px] tracking-[-7.2px] lg:tracking-[-6.4px] max-lg:tracking-[-3px] leading-[96px] max-lg:leading-[56px] [text-shadow:0px_4px_20px_rgba(0,0,0,0.8)] text-brand-primary">
					training programs
				</h1>
				<p
					class="mt-4 text-xl leading-[28px] tracking-0 [text-shadow:0px_4px_4px_rgba(0,0,0,0.8)] text-neutral-1 max-w-[550px] lg:max-w-[700px] max-sm:text-[16px] max-sm:leading-[24px] max-sm:tracking-[-0.4px]">
                    Systematic martial arts instruction designed for competitive dominance and elite physical preparedness.
				</p>
			</div>
		</section>
</Layout>
