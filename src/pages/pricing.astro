---
import Layout from "../layouts/Layout.astro";
import CTAForm from "../components/CTAForm.astro";
import Checkmark from "../assets/icons/checkmark.svg";
import CTAPrimary from "../components/CTAPrimary.astro";
import CTASecondary from "../components/CTASecondary.astro";
import { breadcrumbs, gymId, membershipsId } from "../lib/schema";

const site = Astro.site!;
const pricingUrl = new URL("/pricing/", site).href;
const fee = "Plus a one-time $75 initiation fee.";

const offer = (name: string, description: string, price: number, months: number | null) => ({
	"@type": "Offer",
	name,
	description,
	url: pricingUrl,
	price,
	priceCurrency: "USD",
	priceSpecification: {
		"@type": "UnitPriceSpecification",
		price,
		priceCurrency: "USD",
		referenceQuantity: months
			? { "@type": "QuantitativeValue", value: months, unitCode: "MON" }
			: { "@type": "QuantitativeValue", value: 1, unitCode: "DAY" },
	},
	seller: { "@id": gymId(site) },
});

const schema = [
	{
		"@type": "OfferCatalog",
		"@id": membershipsId(site),
		name: "Memberships",
		url: pricingUrl,
		itemListElement: [
			offer("Month-to-Month", `Unlimited access with no long-term commitment. ${fee}`, 105, 1),
			offer("3-Month Pass", "The best-value option for consistent training: $297 for 3 months ($99/month). No initiation fee.", 297, 3),
			offer("Day Pass", "A flexible one-day option for visitors and drop-ins.", 18, null),
		],
	},
	breadcrumbs(site, [
		{ name: "Home", path: "/" },
		{ name: "Pricing", path: "/pricing/" },
	]),
];
---

<Layout title="Membership Pricing | Harbinger MMA Portland" schema={schema} description="Harbinger MMA memberships in Portland: $105/month with no contract, $99/month on a 3-month pass, or an $18 day pass. Unlimited classes, every discipline.">
	<section class="flex flex-col px-6 py-24 gap-6 lg:gap-12">
		<div class="flex flex-col justify-center items-center gap-3">
			<p class="font-bold text-brand-secondary tracking-[5.6px] max-lg:tracking-[3.6px] uppercase text-[14px] max-lg:text-[8px] [text-shadow:0px_4px_4px_rgba(0,0,0,0.8)]">memberships</p>
			<h1 class="text-neutral-2 bg-color-black uppercase font-bold text-4xl text-center">choose how you train</h1>
			<p class="text-normal text-center leading-[26px] tracking-0 [text-shadow:0px_4px_4px_rgba(0,0,0,0.8)] text-neutral-1 max-sm:text-[16px] max-sm:leading-[26px] max-sm:tracking-[-0.4px]">Clear options, elite coaching, cancel whenever you want.</p>
		</div>
		<div class="flex flex-col lg:flex-row gap-5">
			<div class="flex flex-col basis-1/3 gap-5 bg-neutral-3 p-6 border border-white/10">
				<div class="flex flex-col gap-2">
					<h3 class="text-2xl font-bold uppercase text-neutral-2">month-to-month</h3>
					<p class="text-normal leading-[26px] tracking-0 [text-shadow:0px_4px_4px_rgba(0,0,0,0.8)] text-neutral-1">Unlimited access with no long-term commitment.</p>
				</div>
				<div class="flex flex-col gap-2 border-b-1 border-b-[#FFFFFF10] pb-5">
					<p class="text-5xl text-white font-bold">$105<span class="text-xs font-normal text-[#8A919B]"> / month</span></p>
					<p class="text-sm font-bold text-brand-secondary">+ $75 one-time initiation fee</p>
				</div>
				<div class="flex flex-col flex-1 py-5 gap-3">
					<div class="flex items-center gap-2">
						<Checkmark class="fill-brand-secondary" />
						<p class="text-neutral-1">Unlimited access</p>
					</div>
					<div class="flex items-center gap-2">
						<Checkmark class="fill-brand-secondary" />
						<p class="text-neutral-1">Any class, any time</p>
					</div>
					<div class="flex items-center gap-2">
						<Checkmark class="fill-brand-secondary" />
						<p class="text-neutral-1">All open gym hours</p>
					</div>
					<div class="flex items-center gap-2">
						<Checkmark class="fill-brand-secondary" />
						<p class="text-neutral-1">No long-term commitment</p>
					</div>
				</div>
				<CTASecondary url="#claim-trial" data-plan="month-to-month">book first class</CTASecondary>
			</div>
			<div class="flex flex-col  basis-1/3 bg-neutral-3 border border-brand-primary">
                <div class="flex items-center justify-center text-black text-xs font-bold uppercase w-full bg-brand-primary py-1">best value</div>
				<div class="flex flex-col flex-1 p-6 pt-2 gap-5 bg-neutral-3 border-l-brand-primary border-r-brand-primary border-b-brand-primary">
                    <div class="flex flex-col gap-2">
                        <h3 class="text-2xl font-bold uppercase text-brand-primary">3-month pass</h3>
                        <p class="text-normal leading-[26px] tracking-0 [text-shadow:0px_4px_4px_rgba(0,0,0,0.8)] text-neutral-1">
                            The best-value option for consistent training.
                        </p>
                    </div>
                    <div class="flex flex-col gap-2 border-b-1 border-b-[#FFFFFF10] pb-5">
                        <p class="text-5xl text-white font-bold">$99<span class="text-xs font-normal text-[#8A919B]"> / month</span></p>
                        <p class="text-base font-bold text-white">$297 total for 3 months</p>
                        <p class="text-sm font-bold text-brand-secondary">No initiation fee</p>
                    </div>
                    <div class="flex flex-col flex-1 py-5 gap-3">
                        <div class="flex items-center gap-2">
                            <Checkmark class="fill-brand-primary" />
                            <p class="text-neutral-1">Unlimited access</p>
                        </div>
                        <div class="flex items-center gap-2">
                            <Checkmark class="fill-brand-primary" />
                            <p class="text-neutral-1">Any class, any time</p>
                        </div>
                        <div class="flex items-center gap-2">
                            <Checkmark class="fill-brand-primary" />
                            <p class="text-neutral-1">All open gym hours</p>
                        </div>
                        <div class="flex items-center gap-2">
                            <Checkmark class="fill-brand-primary" />
                            <p class="text-neutral-1">$297 total ($99 / month average)</p>
                        </div>
                    </div>
                    <CTAPrimary url="#claim-trial" data-plan="3-month-pass">book first class</CTAPrimary>
                </div>
			</div>
			<div class="flex flex-col  basis-1/3 gap-5 bg-neutral-3 p-6 border border-white/10">
				<div class="flex flex-col gap-2">
					<h3 class="text-2xl font-bold uppercase text-neutral-2">day pass</h3>
					<p class="text-normal leading-[26px] tracking-0 [text-shadow:0px_4px_4px_rgba(0,0,0,0.8)] text-neutral-1">A flexible one-day option for visitors and drop-ins.</p>
				</div>
				<p class="text-5xl text-white font-bold border-b-1 border-b-[#FFFFFF10] pb-5">$18<span class="text-xs font-normal text-[#8A919B]"> / day</span></p>
				<div class="flex flex-col flex-1 py-5 gap-3">
					<div class="flex items-center gap-2">
						<Checkmark class="fill-brand-secondary" />
						<p class="text-neutral-1">Unlimited access</p>
					</div>
					<div class="flex items-center gap-2">
						<Checkmark class="fill-brand-secondary" />
						<p class="text-neutral-1">Any class, any time</p>
					</div>
					<div class="flex items-center gap-2">
						<Checkmark class="fill-brand-secondary" />
						<p class="text-neutral-1">All open gym hours</p>
					</div>
					<div class="flex items-start gap-2">
						<Checkmark class="fill-brand-secondary" />
						<p class="text-neutral-1">One full day of access across all disciplines</p>
					</div>
				</div>
				<CTASecondary url="#claim-trial" data-plan="day-pass">book first class</CTASecondary>
			</div>
		</div>
		<p class="max-w-4xl text-[#c0c7d1] mx-auto text-[12px] tracking-[1px] text-center leading-[15px]">
			Month-to-month membership is $105 per month plus a one-time $75 initiation fee, with no long-term contract. The 3-month pass is $297,
			which works out to $99 per month, with no initiation fee. Both include unlimited classes in every discipline. A day pass is $18 for one full day of access.
			There's no trial class: send us your details below and we'll reach out to book your first class.
		</p>
	</section>
	<CTAForm />
</Layout>
