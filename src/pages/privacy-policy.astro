---
import Layout from "../layouts/Layout.astro";
import policy from "../data/privacy-policy.html?raw";
---

<Layout title="Privacy Policy | Harbinger MMA" description="How Harbinger MMA, LLC collects, uses, and protects your personal information, and how to exercise your privacy rights.">
	<section class="flex flex-col items-center px-6 py-24 gap-12">
		<div class="flex flex-col justify-center items-center gap-3">
			<p class="font-bold text-brand-secondary tracking-[5.6px] max-lg:tracking-[3.6px] uppercase text-[14px] max-lg:text-[8px]">legal</p>
			<h1 class="text-neutral-2 uppercase font-bold text-4xl text-center">privacy policy</h1>
		</div>
		<article
			class="w-full max-w-3xl text-neutral-1 leading-[26px] break-words [&_h2]:text-neutral-2 [&_h2]:text-2xl [&_h2]:font-bold [&_h2]:mt-12 [&_h2]:mb-4 [&_h2]:scroll-mt-24 [&_h3]:text-neutral-2 [&_h3]:text-lg [&_h3]:font-bold [&_h3]:mt-8 [&_h3]:mb-3 [&_h3]:scroll-mt-24 [&_p]:mb-4 [&_ul]:list-disc [&_ul]:pl-6 [&_ul]:mb-4 [&_li]:mb-2 [&_a]:text-brand-primary [&_a]:underline [&_strong]:text-neutral-2"
			set:html={policy}
		/>
	</section>
</Layout>
