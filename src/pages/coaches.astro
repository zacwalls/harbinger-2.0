---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";

import HeroImage from "/src/assets/coaches-hero-bg.jpg";
import CoachGrid from "../components/coaches/CoachGrid.astro";
import CTAForm from "../components/CTAForm.astro";
---

<Layout>
	<section
		class="relative flex items-start justify-left py-20 overflow-hidden">
		<div class="absolute inset-0 overflow-hidden">
			<Image
				alt=""
				class="absolute w-[120%] h-[140%] max-md:h-[115%] max-sm:w-[1279px] max-sm:h-auto top-[-17%] left-[-13%] max-sm:left-[calc(-1279px*.57)] max-md:left-[-13%] max-w-none opacity-80"
				src={HeroImage}
				format="webp"
				quality="high"
			/>
		</div>
		<div
			class="absolute inset-0 bg-gradient-to-t from-black/[0.63] via-[rgba(80,80,80,0.63)] to-black/[0.63]">
		</div>
		<div
			class="relative z-10 flex flex-col max-w-[700px] w-full px-6 py-21 max-md:mx-auto max-md:w-fit">
			<p
				class="font-bold text-[#e9c349] tracking-[5.6px] max-lg:tracking-[3.6px] uppercase text-[14px] max-lg:text-[8px] [text-shadow:0px_4px_4px_rgba(0,0,0,0.8)]">
				elite instruction
			</p>
			<h1
				class="font-bold text-white uppercase text-[96px] max-lg:text-[48px] tracking-[-7.2px] max-lg:tracking-[-3px] leading-[96px] max-lg:leading-[56px] [text-shadow:0px_4px_20px_rgba(0,0,0,0.8)]">
				world class <span class="text-brand-primary">pedigree</span>
			</h1>
			<p
				class="mt-4 text-xl leading-[28px] tracking-0 border-l-4 border-brand-primary pl-6 [text-shadow:0px_4px_4px_rgba(0,0,0,0.8)] text-neutral-1 max-w-[550px] max-sm:text-[16px] max-sm:leading-[24px] max-sm:tracking-[-0.4px]">
				Learn from active competitors and world-renowned masters. Our
				coaching staff brings decades of professional experience from
				the UFC, Bellator, and ADCC to the mats every day.
			</p>
		</div>
	</section>
	<section class="bg-[#0e0e0e] flex justify-center py-[92px] px-6">
		<CoachGrid />
	</section>
    <CTAForm />
</Layout>
