---
import Layout from "../layouts/Layout.astro";
import HeroSection from "../components/home/HeroSection.astro";
import StatsSection from "../components/home/StatsSection.astro";
import ClassesSection from "../components/home/ClassesSection.astro";
import CoachesSection from "../components/home/CoachesSection.astro";
import CTAForm from "../components/CTAForm.astro";
import Footer from "../components/Footer.astro";
---

<Layout>
  <HeroSection />
  <StatsSection />
  <ClassesSection />
  <CoachesSection />
  <CTAForm />
  <Footer />
</Layout>

<style is:global>
  @import "tailwindcss";
  @import url("https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300..700&display=swap");
  @theme {
    --font-display: "Space Grotesk", sans-serif;
    --default-font-family: "Space Grotesk", sans-serif;
    --color-neutral-1: #c0c7d1;
    --color-brand-primary: #2e86c1;
    --color-brand-secondary: #e9c349;
  }
</style>
