---
import { getCollection, getEntries } from "astro:content";

import ResponsiveImage from '../../components/ResponsiveImage.astro'
import Layout from "../../layouts/Layout.astro";
import CTAForm from "../../components/CTAForm.astro";
import CoachCard from "../../components/coaches/CoachCard.astro";
import { ScheduleGrid } from "../../components/WeeklySchedule.tsx";
import { breadcrumbs, gymId, membershipsId } from "../../lib/schema";

export async function getStaticPaths() {
	const classes = await getCollection("classes");

	return classes.map((classItem) => ({
		params: { slug: classItem.id },
		props: { classItem },
	}));
}

const {classItem } = Astro.props;
const { title, excerpt, metaDescription, description, featuredImage, classImageDesktop, classImageMobile, schedulePattern } = classItem.data;
const coaches = classItem.data.coaches ? await getEntries(classItem.data.coaches) : [];

const pattern = schedulePattern && new RegExp(schedulePattern);
const sessions = pattern
	? (await getCollection("schedule")).filter((session) => pattern.test(session.data.className))
	: [];

const heading = "font-bold text-neutral-2 uppercase text-3xl lg:text-4xl mb-6";

const site = Astro.site!;
const pageUrl = new URL(`/classes/${classItem.id}/`, site).href;
const schema = [
	{
		"@type": "Service",
		"@id": `${pageUrl}#service`,
		url: pageUrl,
		name: title,
		serviceType: `${title} classes`,
		description: excerpt,
		provider: { "@id": gymId(site) },
		areaServed: { "@type": "City", name: "Portland" },
		offers: { "@id": membershipsId(site) },
	},
	breadcrumbs(site, [
		{ name: "Home", path: "/" },
		{ name: "Classes", path: "/classes/" },
		{ name: title, path: `/classes/${classItem.id}/` },
	]),
];
---

<Layout title={`${title} Classes in Portland, OR | Harbinger MMA`} description={metaDescription ?? excerpt} schema={schema} image={featuredImage}>
	<section
		class="relative flex items-end justify-left min-h-[600px] lg:min-h-[700px] lg:py-32 lg:px-24 overflow-hidden">
		<div class="absolute inset-0 w-full h-full aspect-[16/9] left-0">
			<ResponsiveImage
				alt=""
				className="absolute w-full  h-full object-cover object-bottom grayscale opacity-80"
				mobileImgUrl={classImageMobile}
				desktopImgUrl={classImageDesktop}
			/>
		</div>
		<div class="absolute inset-0 bg-[linear-gradient(180deg,rgba(0,0,0,0.63)_10.1%,rgba(80,80,80,0.63)_46.15%,rgba(0,0,0,0.63)_87.02%),linear-gradient(0deg,#131313_0%,rgba(19,19,19,0.4)_50%,rgba(19,19,19,0)_100%)]"></div>
		<div class="relative z-10 flex flex-col max-w-[700px] w-full px-6 py-15 lg:px-0 lg:py-0 max-md:mx-auto max-md:w-fit">
			<h1
				class="font-bold text-white uppercase text-[96px] max-lg:text-[48px] tracking-[-7.2px] lg:tracking-[-6.4px] max-lg:tracking-[-3px] leading-[96px] max-lg:leading-[56px] [text-shadow:0px_4px_20px_rgba(0,0,0,0.8)] text-brand-primary">
				{title}
			</h1>
			<p
				class="mt-4 text-xl leading-[28px] tracking-0 border-l-4 border-brand-primary pl-6 [text-shadow:0px_4px_4px_rgba(0,0,0,0.8)] text-neutral-1 max-w-[550px] lg:max-w-[700px] max-sm:text-[16px] max-sm:leading-[24px] max-sm:tracking-[-0.4px]">
				{excerpt}
			</p>
		</div>
	</section>
	<section class="px-6 py-24 lg:py-32 lg:px-24">
		<h2 class={heading}>About {title}</h2>
		<p class="text-neutral-1 leading-loose text-lg whitespace-pre-line">{description}</p>
	</section>
	{sessions.length > 0 && (
		<section class="px-6 pb-24 lg:px-24">
			<h2 class={heading}>{title} class times</h2>
			<p class="text-neutral-1 leading-loose text-lg mb-6">
				{sessions.length} {sessions.length === 1 ? "session" : "sessions"} a week at our Portland gym.
				See the <a href="/schedule/" class="text-brand-primary underline">full weekly schedule</a> for every class.
			</p>
			<ScheduleGrid schedule={sessions} />
		</section>
	)}
	{coaches.length > 0 && (
		<section class="px-6 pb-24 lg:px-24">
			<h2 class={heading}>{title} coaches</h2>
			<div class="flex flex-wrap max-md:flex-col gap-8">
				{coaches.map((coach) => (
					<CoachCard
						slug={coach.id}
						name={coach.data.name}
						title={coach.data.title}
						excerpt={coach.data.excerpt}
						thumbnail={coach.data.featuredImagePath}
					/>
				))}
			</div>
		</section>
	)}
	<CTAForm />
</Layout>
