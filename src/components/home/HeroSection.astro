---
import CTAPrimary from "../../components/CTAPrimary.astro";
import CTASecondary from "../../components/CTASecondary.astro";
---

<section class="relative flex items-center justify-center min-h-[700px] overflow-hidden">
  <div class="absolute inset-0 overflow-hidden">
    <img
      alt=""
      class="absolute w-full h-[160%] max-lg:h-[115%] max-lg:top-[-15%] max-lg:left-[-186px] max-lg:w-auto top-[-35%] left-0 max-w-none"
      src="/src/assets/hero-image.jpg"
    />
  </div>
  <div class="absolute inset-0 bg-gradient-to-t from-black/[0.63] via-[rgba(80,80,80,0.63)] to-black/[0.63]">
  </div>
  <div class="relative z-10 flex flex-col items-center max-w-[1280px] w-full px-6 py-21 gap-2 text-center">
    <div class="w-[160px] max-lg:w-[128px]">
      <img
        alt="Harbinger Sword Logo"
        class="w-full h-auto"
        src="/src/assets/harbinger-logo-complex.svg"
      />
    </div>
    <p
      class="font-bold text-[#e9c349] tracking-[5.6px] max-lg:tracking-[3.6px] uppercase text-[14px] max-lg:text-[8px] [text-shadow:0px_4px_4px_rgba(0,0,0,0.8)]"
    >
      Portland's Premier Combat Training Facility
    </p>
    <h1
      class="font-bold text-white uppercase text-[96px] max-lg:text-[48px] tracking-[-7.2px] max-lg:tracking-[-3px] leading-[1.275] max-lg:leading-[56px] [text-shadow:0px_4px_20px_rgba(0,0,0,0.8)]"
    >
      forge the fighter in you
    </h1>
    <div class="flex items-center gap-7 mt-2 max-lg:mt-0 max-lg:gap-1 max-lg:flex-col max-lg:mt-4 max-lg:gap-2">
      <div
        class="font-light text-[#e5e2e1] text-[60px] max-lg:text-[32px] tracking-[-3px] max-lg:tracking-[1%] uppercase leading-[60px] max-lg:leading-[40px] [text-shadow:0px_4px_20px_rgba(0,0,0,0.8)]"
      >
        HERE TO WIN<span class="font-bold text-[#2e86c1]">.</span>
      </div>
      <div class="w-[2px] h-[48px] bg-[rgba(46,134,193,0.6)] max-lg:rotate-180 max-lg:w-[233px] max-lg:h-[2px]"></div>
      <p
        class="font-normal text-[#c0c7d1] text-[18px] max-lg:text-[16px] max-w-[428px] text-left max-lg:tracking-none leading-[28px] [text-shadow:0px_4px_4px_rgba(0,0,0,0.8)] max-lg:text-center"
      >
        Elite martial arts instruction for those who demand excellence. From Day
        1 beginners to professional fighters.
      </p>
    </div>
    <div class="flex gap-5 mt-16 max-lg:mt-8 max-lg:flex-col max-lg:w-full max-lg:gap-4">
      <CTAPrimary url="#claim-trial">CLAIM TRIAL</CTAPrimary>
      <CTASecondary url="/schedule">VIEW SCHEDULE</CTASecondary>
    </div>
  </div>
</section>
