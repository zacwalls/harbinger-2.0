---
import CTASecondary from "../CTASecondary.astro";
import CoachGrid from "../coaches/CoachGrid.astro";

import { Image } from "astro:assets";
import heroImage from "../../assets/coaches-section-bg.jpg";
---

<section class="relative overflow-hidden py-[92px] flex justify-center">
    <div class="absolute left-0 top-0 w-full h-full pointer-events-none overflow-hidden">
        <Image src={heroImage} alt=""  class="absolute w-[130%] max-md:w-[225%] top-0 max-md:top-[-20%] max-sm:top-0 max-md:left-[-35%] max-w-none" />
        <div class="absolute inset-0 bg-gradient-to-b from-black/[0.63] via-[rgba(80,80,80,0.63)] to-black/[0.63]"></div>
    </div>
    <div class="relative z-10 w-full max-w-[1232px] px-6">
        <div class="flex flex-col items-start min-md:max-w-[616px]">
            <h2 class="font-bold text-[#e5e2e1] text-[48px] max-md:text-[40px] tracking-[-1.8px] uppercase leading-[48px] pb-8 [text-shadow:0px_4px_4px_rgba(0,0,0,0.25)]">learn from coaches who actually fight</h2>
            <div class="relative border-l-4 border-[#e9c349] pl-4 w-full">
                <p class="text-[#e5e2e1] text-[32px] max-md:text-[20px] leading-[32px] max-md:leading-[24px] [text-shadow:0px_4px_4px_rgba(0,0,0,0.25)]">Our coaching staff is built from successful active competitors and veterans of the highest levels of professional combat. We don't just teach—we win.</p>
            </div>
            <div class="grid grid-cols-2 gap-8 pt-8 pb-10 w-full">
                <div>
                    <p class="font-bold text-[#e9c349] text-[36px] leading-[40px] [text-shadow:0px_4px_4px_rgba(0,0,0,0.25)]">150+</p>
                    <p class="text-[#c0c7d1] text-[14px] max-md:text-[10px] tracking-[1.4px] uppercase leading-[20px]">active members</p>
                </div>
                <div>
                    <p class="font-bold text-[#e9c349] text-[36px] leading-[40px] [text-shadow:0px_4px_4px_rgba(0,0,0,0.25)]">7</p>
                    <p class="text-[#c0c7d1] text-[14px] max-md:text-[10px] tracking-[1.4px] uppercase leading-[20px]">WORLD CLASS COACHES</p>
                </div>
            </div>
            <div class="flex max-md:flex-col items-stretch w-full">
                <CTASecondary>view all coaches</CTASecondary>
            </div>
        </div>
    </div>
</section>

<section class="bg-[#0e0e0e] flex justify-center py-[92px] px-6">
    <CoachGrid />
</section>