---
import ClassGrid from "../classes/ClassGrid.astro";
---

<section class="bg-[#131313] px-6 py-[92px] flex justify-center">
  <div class="flex flex-col gap-16 w-full max-w-[1232px]">
    <div class="flex items-end justify-between w-full">
      <div class="flex flex-col gap-6 max-w-[672px]">
        <h2
          class="text-[#e5e2e1] text-[48px] tracking-[-3.6px] uppercase leading-[72px]"
          style='font-family: "Space Grotesk", sans-serif; font-weight: 700;'
        >
          complete combat system
        </h2><p
          class="text-[#c0c7d1] text-[20px] leading-[28px]"
          style="font-family: Inter, sans-serif; font-weight: 400;"
        >
          Train across every range of diciplines. From boxing to BJJ, every
          program is designed to build real skill under pressure.
        </p>
      </div>
      <button
        class="relative flex items-center gap-2 border-b-2 border-[#e9c349] pb-2 cursor-pointer"
      >
        <span
          class="font-bold text-[#e9c349] text-[18px] tracking-[1.8px] uppercase whitespace-nowrap"
          >VIEW ALL DICIPLINES</span
        >
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
          <path
            d="M14 18L12.6 16.55L16.15 13H4V11H16.15L12.6 7.45L14 6L20 12L14 18Z"
            fill="#E9C349"></path>
        </svg>
      </button>
    </div>
    <ClassGrid />
    </div>
  </div>
</section>
