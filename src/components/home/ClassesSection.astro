---
import ClassGrid from '../classes/ClassGrid.astro';
---

<section class="bg-[#131313] px-6 py-16 md:py-[92px] flex justify-center">
  <div class="flex flex-col gap-10 md:gap-16 w-full max-w-[1232px]">
    <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-6 sm:gap-6 w-full">
      <div class="flex flex-col gap-4 md:gap-6 max-w-[672px]">
        <h2 class="text-[#e5e2e1] text-3xl sm:text-4xl lg:text-[48px] tracking-tight lg:tracking-[-3.6px] uppercase leading-tight lg:leading-[72px]">
          complete combat system
        </h2><p
          class="text-[#c0c7d1] text-base md:text-[20px] leading-relaxed md:leading-[28px]"
        >
          Train across every range of diciplines. Every program is designed to build real skill under pressure in a 12,300 sq. ft. facility with dedicated training areas for striking, grappling, and strength & conditioning.
        </p>
      </div>
      <button
        class="relative flex items-center gap-2 border-b-2 border-[#e9c349] pb-2 cursor-pointer self-start sm:self-auto"
      >
        <span
          class="font-bold text-[#e9c349] text-sm sm:text-[18px] tracking-[1.8px] uppercase whitespace-nowrap"
          >VIEW ALL DICIPLINES</span
        >
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
          <path
            d="M14 18L12.6 16.55L16.15 13H4V11H16.15L12.6 7.45L14 6L20 12L14 18Z"
            fill="#E9C349"></path>
        </svg>
      </button>
    </div>
    <ClassGrid />
    </div>
  </div>
</section>

<section class="bg-[#131313] px-6 pb-16 md:pb-24 flex justify-center">
