---
import { getCollection } from 'astro:content';
import ClassCard from "../classes/ClassCard.astro";

const classes = (await getCollection('classes').then((classes) => classes.slice(0, 7)));
---

<div class="grid grid-cols-3 gap-6" style="grid-template-rows: 450px 450px;">
    {classes.map((classItem) => (
        <ClassCard
            name={classItem.data.title}
            excerpt={classItem.data.excerpt}
            thumbnail={classItem.data.featuredImagePath}
        />
    ))}
    </div>