---
import type { ImageMetadata } from "astro";
import { getImage } from "astro:assets";

interface Props {
	mobileImgUrl: ImageMetadata;
	desktopImgUrl: ImageMetadata;
	className: string;
	alt: string;
}

const { mobileImgUrl, desktopImgUrl, alt, className } = Astro.props;

// Never upscale: clamp widths to the source image width.
const fitWidths = (img: ImageMetadata, widths: number[]) => [
	...new Set(widths.map((w) => Math.min(w, img.width))),
];

// AVIF first; browsers without AVIF support fall through to WebP.
const formats = ["avif", "webp"] as const;

const variants = (src: ImageMetadata, widths: number[]) =>
	Promise.all(
		formats.map(async (format) => ({
			format,
			image: await getImage({ src, widths: fitWidths(src, widths), format }),
		})),
	);

const mobileImgs = await variants(mobileImgUrl, [480, 800, 1200]);
const desktopImgs = await variants(desktopImgUrl, [1280, 1920, 2560]);
const fallback = desktopImgs.find((v) => v.format === "webp")!.image;
---

<picture class={className}>
	{mobileImgs.map(({ format, image }) => (
		<source media="(max-width: 799px)" type={`image/${format}`} srcset={image.srcSet.attribute} sizes="100vw" />
	))}
	{desktopImgs.map(({ format, image }) => (
		<source media="(min-width: 800px)" type={`image/${format}`} srcset={image.srcSet.attribute} sizes="100vw" />
	))}
	<img
		class="w-full h-full"
		src={fallback.src}
		alt={alt}
		width={desktopImgUrl.width}
		height={desktopImgUrl.height}
		loading="eager"
		fetchpriority="high"
		decoding="async"
	/>
</picture>
