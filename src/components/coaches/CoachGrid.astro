---
import { getCollection } from "astro:content";
import CoachCard from "../coaches/CoachCard.astro";

const coaches = (await getCollection('coaches').then((coaches) => coaches.slice(0, 3)));
---

<div class="flex flex-wrap max-md:flex-col gap-8 justify-center">
    {coaches.map((coach) => (
        <CoachCard
            name={coach.data.name}
            title={coach.data.title}
            excerpt={coach.data.excerpt}
            thumbnail={coach.data.featuredImagePath}
        />
    ))}
</div>