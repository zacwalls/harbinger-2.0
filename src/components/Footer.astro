---
import NavLogo from "../assets/NavLogo.svg";
import FacebookIcon from "../assets/icons/facebook.svg";
import InstagramIcon from "../assets/icons/instagram.svg";
import TiktokIcon from "../assets/icons/tiktok.svg";
---

<footer class="w-full flex flex-col py-16 px-8 gap-16 border-[rgba(64,72,80,0.1)] border-solid border-t inset-0">
    <div class="flex max-md:flex-wrap max-w-[1280px] relative shrink-0 w-full justify-start gap-12">
        <div class="flex flex-col grow lg:max-w-[300px] max-md:w-full gap-4">
            <NavLogo class="w-36" />
            <p class="text-neutral-1 leading-10 max-sm:text-sm">THE PREMIER MULTIDISCIPLINARY COMBAT SPORTS ACADEMY IN THE PACIFIC NORTHWEST.</p>
        </div>
        <div class="flex flex-col grow">
            <h3 class="uppercase font-bold text-brand-secondary mb-6 tracking-[1.4px]">programs</h3>
            <div class="flex flex-col gap-3">
                <a href="/classes/mma" class="text-neutral-1 uppercase max-sm:text-sm">MMA</a>
                <a href="/classes/bjj" class="text-neutral-1 uppercase max-sm:text-sm">BJJ</a>
                <a href="/classes/boxing" class="text-neutral-1 uppercase max-sm:text-sm">BOXING</a>
                <a href="/classes/muay-thai" class="text-neutral-1 uppercase max-sm:text-sm">Muay Thai</a>
            </div>
        </div>
        <div class="flex flex-col grow">
            <h3 class="uppercase font-bold text-brand-secondary mb-6 tracking-[1.4px]">community</h3>
            <div class="flex flex-col gap-3">
                <a href="/coaches" class="text-neutral-1 uppercase max-sm:text-sm">coaches</a>
                <a href="/pricing" class="text-neutral-1 uppercase max-sm:text-sm">pricing</a>
                <a href="/schedule" class="text-neutral-1 uppercase max-sm:text-sm">schedule</a>
                <a href="/shop" class="text-neutral-1 uppercase max-sm:text-sm">shop</a>
            </div>
        </div>
        <div class="flex flex-col grow">
            <h3 class="uppercase font-bold text-brand-secondary mb-6 tracking-[1.4px]">connect</h3>
            <div class="flex gap-4">
                <a href="https://www.instagram.com/harbinger_mma" target="_blank" class="text-neutral-1 uppercase">
                    <InstagramIcon class="fill-neutral-1 w-5" />
                </a>
                <a href="https://www.facebook.com/p/Harbingermma-61570838121312/" target="_blank" class="text-neutral-1 uppercase">
                    <FacebookIcon class="fill-neutral-1 w-5" />
                </a>
                <a href="https://www.tiktok.com/@harbingermma" target="_blank" class="text-neutral-1 uppercase">
                    <TiktokIcon class="fill-neutral-1 w-5" />
                </a>
            </div>
        </div>
    </div>
    <div class="flex justify-center pt-8 border-[rgba(64,72,80,0.1)] border-solid border-t inset-0">
        <p class="text-xs text-neutral-1 leading-[0] tracking-[1.2px]">© {new Date().getFullYear()} HARBINGER MMA PORTLAND. HERE TO WIN.</p>
    </div>
</footer>