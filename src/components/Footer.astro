---
import NavLogo from "../assets/NavLogo.svg";
import FacebookIcon from "../assets/icons/facebook.svg";
import InstagramIcon from "../assets/icons/instagram.svg";
import TiktokIcon from "../assets/icons/tiktok.svg";
import { hours, formatTime } from "../data/hours";
import { mapsUrl } from "../data/location";
---

<footer class="w-full flex flex-col py-16 px-8 gap-16 border-[rgba(64,72,80,0.1)] border-solid border-t inset-0">
    <div class="flex max-md:flex-wrap max-w-[1280px] relative shrink-0 w-full justify-start gap-12">
        <div class="flex flex-col grow max-md:w-full uppercase">
            <img src={NavLogo.src} alt="Harbinger MMA" width="144" height="58" loading="lazy" class="w-36 h-auto" /><br>
            <p class="text-neutral-1 max-sm:text-sm"><a href={mapsUrl} target="_blank" rel="noopener">2626 S Corbett Ave,<br>Portland, OR 97201</a></p><br>
            <p class="text-neutral-1 leading-10 max-sm:text-sm"><a href="tel:5033105001">(503) 310-5001</a></p>
            <p class="text-neutral-1 leading-10 max-sm:text-sm"><a href="mailto:contact@harbingermma.com">contact@harbingermma.com</a></p>
        </div>
        <div class="flex flex-col grow">
            <h2 class="uppercase font-bold text-brand-secondary mb-6 tracking-[1.4px]">hours</h2>
            <dl class="grid grid-cols-[auto_auto] justify-start gap-x-6 gap-y-3 text-neutral-1 uppercase max-sm:text-sm">
                {hours.map(({ label, opens, closes }) => (
                    <>
                        <dt>{label}</dt>
                        <dd>{formatTime(opens)}-{formatTime(closes)}</dd>
                    </>
                ))}
            </dl>
        </div>
        <div class="flex flex-col grow">
            <h2 class="uppercase font-bold text-brand-secondary mb-6 tracking-[1.4px]">connect</h2>
            <div class="flex gap-4">
                <a href="https://www.instagram.com/harbinger_mma" target="_blank" rel="noopener" aria-label="Harbinger MMA on Instagram" class="text-neutral-1 uppercase">
                    <InstagramIcon class="fill-neutral-1 w-5" />
                </a>
                <a href="https://www.facebook.com/p/Harbingermma-61570838121312/" target="_blank" rel="noopener" aria-label="Harbinger MMA on Facebook" class="text-neutral-1 uppercase">
                    <FacebookIcon class="fill-neutral-1 w-5" />
                </a>
                <a href="https://www.tiktok.com/@harbingermma" target="_blank" rel="noopener" aria-label="Harbinger MMA on TikTok" class="text-neutral-1 uppercase">
                    <TiktokIcon class="fill-neutral-1 w-5" />
                </a>
            </div>
        </div>
    </div>
    <div class="flex flex-col items-center gap-6 pt-8 border-[rgba(64,72,80,0.1)] border-solid border-t inset-0">
        <nav aria-label="Legal" class="flex flex-wrap justify-center gap-x-6 gap-y-2 text-xs text-neutral-1 uppercase tracking-[1.2px]">
            <a href="/privacy-policy/">Privacy policy</a>
        </nav>
        <p class="text-xs text-neutral-1 leading-[0] tracking-[1.2px]">© {new Date().getFullYear()} HARBINGER MMA PORTLAND. HERE TO WIN.</p>
    </div>
</footer>