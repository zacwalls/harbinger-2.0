---
const { url } = Astro.props;
---

<a href={url} class="cta-primary"><slot /></a>

<style>
  .cta-primary {
    padding: 8px 24px;
    background-color: var(--brand-primary);
    height: fit-content;
    box-shadow: 0px 25px 50px -12px rgba(46, 134, 193, 0.4);
    text-decoration: none;
    font-weight: bold;
    font-size: 1rem;
    line-height: 1.5rem;
    letter-spacing: -0.4px;
    text-transform: uppercase;
    color: white;
  }
</style>
