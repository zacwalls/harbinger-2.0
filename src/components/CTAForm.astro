---
import Checkmark from "/src/assets/icons/checkmark.svg";
import TrialForm from "./BookClassForm";
---

<section
	id="claim-trial"
	class="bg-[#0e0e0e] relative px-6 py-23 flex justify-center">
	<div
		class="absolute inset-0 opacity-10 overflow-hidden pointer-events-none">
		<div
			class="absolute bg-[#2e86c1] blur-[60px] left-[-96px] top-[-96px] w-[384px] h-[384px]">
		</div>
		<div
			class="absolute bg-[#e9c349] blur-[60px] bottom-[-96px] right-[-96px] w-[384px] h-[384px]">
		</div>
	</div>
	<div
		class="flex max-lg:flex-col gap-16 items-center justify-between w-full max-w-[1232px]">
		<div class="flex flex-col gap-6 max-w-[500px]">
			<h2
				class="text-[#e5e2e1] font-bold text-[96px] max-md:text-[48px] tracking-[-4.8px] max-md:tracking-[-3px] uppercase leading-[96px]">
				READY TO <span class="text-[#e9c349]">WIN?</span>
			</h2>
			<p class="text-[#c0c7d1] text-[20px] text-[16px] leading-[28px]">
				Enter your details below and we'll reach out to schedule your
				first session for free.
			</p>
			<div class="flex flex-col gap-6 max-md:gap-2 mt-2">
				<div class="flex items-center gap-4">
					<Checkmark class="fill-brand-secondary" />
					<span class="text-[#e5e2e1] text-[14px] tracking-[1.4px] uppercase">Pro-Level Coaching Staff</span>
				</div>
				<div class="flex items-center gap-4">
					<Checkmark class="fill-brand-secondary" />
					<span class="text-[#e5e2e1] text-[14px] tracking-[1.4px] uppercase">Pathways to competition</span>
				</div>
				<div class="flex items-center gap-4">
					<Checkmark class="fill-brand-secondary" />
					<span class="text-[#e5e2e1] text-[14px] tracking-[1.4px] uppercase">Elite coaching for all levels</span>
				</div>
			</div>
		</div>

		<TrialForm client:load />
	</div>
</section>