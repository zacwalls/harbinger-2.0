---
import { Image } from "astro:assets";
import CTAPrimary from "./CTAPrimary.astro";
import checkmark from "/src/assets/icons/checkmark.svg";
import chevronDown from "/src/assets/icons/chevron-down-1.svg";
---

<section class="bg-[#0e0e0e] relative px-6 py-23 flex justify-center">
	<div class="absolute inset-0 opacity-10 overflow-hidden pointer-events-none">
		<div class="absolute bg-[#2e86c1] blur-[60px] left-[-96px] top-[-96px] w-[384px] h-[384px]"></div>
		<div class="absolute bg-[#e9c349] blur-[60px] bottom-[-96px] right-[-96px] w-[384px] h-[384px]"></div>
	</div>
	<div class="flex max-lg:flex-col gap-16 items-center justify-between w-full max-w-[1232px]">
		<div class="flex flex-col gap-6 max-w-[500px]">
			<h2 class="text-[#e5e2e1] font-bold text-[96px] max-md:text-[48px] tracking-[-4.8px] max-md:tracking-[-3px] uppercase leading-[96px]">
				READY TO <span class="text-[#e9c349]">WIN?</span>
			</h2>
			<p class="text-[#c0c7d1] text-[20px] text-[16px] leading-[28px]">Enter your details below and we'll reach out to schedule your first session for free.</p>
			<div class="flex flex-col gap-6 max-md:gap-2 mt-2">
				<div class="flex items-center gap-4">
					<Image src={checkmark} alt="" format="svg" quality="high" />
					<span class="text-[#e5e2e1] text-[14px] tracking-[1.4px] uppercase">Pro-Level Coaching Staff</span>
				</div>
				<div class="flex items-center gap-4">
					<Image src={checkmark} alt="" format="svg" quality="high" />
					<span class="text-[#e5e2e1] text-[14px] tracking-[1.4px] uppercase">Pathways to competition</span>
				</div>
				<div class="flex items-center gap-4">
					<Image src={checkmark} alt="" format="svg" quality="high"/>
					<span class="text-[#e5e2e1] text-[14px] tracking-[1.4px] uppercase">Elite coaching for all levels</span>
				</div>
			</div>
		</div>
		<div class="relative bg-[#201f1f] border border-[rgba(64,72,80,0.2)] shadow-[0_25px_50px_-12px_rgba(0,0,0,0.25)] px-14 max-md:px-4 py-10">
			<div class="flex flex-col gap-6">
				<div class="flex flex-col gap-2">
					<label class="text-[#c0c7d1] text-[12px] tracking-[1.2px] uppercase leading-[16px]">Full Name</label>
					<div class="relative bg-[#1c1b1b] border border-[rgba(64,72,80,0.3)]">
						<input
							type="text"
							placeholder="John Doe"
							class="w-full bg-transparent px-[17px] py-[18px] text-[#6b7280] text-[16px] uppercase outline-none placeholder:text-[#6b7280]"
						/>
					</div>
				</div>
				<div class="flex flex-col gap-2">
					<label class="text-[#c0c7d1] text-[12px] tracking-[1.2px] uppercase leading-[16px]">Email Address</label>
					<div class="relative bg-[#1c1b1b] border border-[rgba(64,72,80,0.3)]">
						<input
							type="email"
							placeholder="email@domain.com"
							class="w-full bg-transparent px-[17px] py-[18px] text-[#6b7280] text-[16px] uppercase outline-none placeholder:text-[#6b7280]"
						/>
					</div>
				</div>
				<div class="flex flex-col gap-2">
					<label class="text-[#c0c7d1] text-[12px] tracking-[1.2px] uppercase leading-[16px]">Primary Interest</label>
					<div class="relative bg-[#1c1b1b] border border-[rgba(64,72,80,0.3)] h-[58px] flex items-center">
						<select class="w-full bg-transparent px-[17px] py-0 text-white text-[16px] uppercase outline-none appearance-none cursor-pointer h-full">
							<option value="muay-thai" class="bg-[#1c1b1b]">Muay Thai</option>
							<option value="bjj" class="bg-[#1c1b1b]">BJJ</option>
							<option value="boxing" class="bg-[#1c1b1b]">Boxing</option>
							<option value="wrestling" class="bg-[#1c1b1b]">Wrestling</option>
							<option value="mma" class="bg-[#1c1b1b]">MMA</option>
						</select>
						<div class="absolute right-[9px] top-1/2 -translate-y-1/2 pointer-events-none">
							<Image src={chevronDown} alt="" format="svg" quality="high" />
						</div>
					</div>
				</div>
				<div class="flex flex-col items-stretch w-full mt-4">
					<CTAPrimary>book first session</CTAPrimary>
				</div>
				<p class="text-[#c0c7d1] text-[10px] tracking-[1px] uppercase text-center leading-[15px] px-4">By submitting, you agree to receive communications regarding your trial.</p>
			</div>
		</div>
	</div>
</section>
