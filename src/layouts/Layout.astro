---
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { siteGraph } from "../lib/schema";

const { title, description, schema = [] } = Astro.props;

const site = Astro.site!;
const canonicalUrl = new URL(Astro.url.pathname, site).href;
const isProduction = site.hostname.endsWith("harbingermma.com");
const jsonLd = {
	"@context": "https://schema.org",
	"@graph": [...siteGraph(site), ...schema],
};
---

<!doctype html>
<html lang="en" class="w-screen">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300..700&display=swap" />
		<title>{title || "Harbinger MMA"}</title>
		{description && <meta name="description" content={description} />}
		<link rel="canonical" href={canonicalUrl} />
		{!isProduction && <meta name="robots" content="noindex, nofollow" />}
		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
	</head>
	<body>
		<Nav />
		<div
			class="bg-[#0e0e0e] font-['Space Grotesk',sans-serif] overflow-clip">
			<slot />
			<Footer />
		</div>
	</body>
</html>

<style is:global>
	@import "tailwindcss";
	@theme {
		--font-display: "Space Grotesk", sans-serif;
		--default-font-family: "Space Grotesk", sans-serif;
		--color-neutral-1: #c0c7d1;
		--color-neutral-2: #e5e2e1;
		--color-neutral-3: #1c1b1b;
		--color-brand-primary: #2e86c1;
		--color-brand-secondary: #e9c349;
	}

	html {
		scroll-behavior: smooth;
	}
	@media (prefers-reduced-motion: reduce) {
		html {
			scroll-behavior: auto;
		}
	}
</style>
